# See https://hselp.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code skill scaffolding (not part of the app)
.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# גופנים מסחריים בתשלום (Ploni / Anomalia).
# לא נכנסים לריפו ולא לפרודקשן: public/ מוגש סטטית, כלומר קובץ שיושב
# כאן ניתן להורדה מהדומיין הציבורי וניתן לזהות אותו בבקשת רשת אחת.
# אין קוד שמפנה אליהם — האתר רץ על Heebo ו-Secular One מ-next/font.
# אם יירכש רישיון: להסיר את השורה הזו ולהוסיף @font-face ב-globals.css.
/public/fonts/
